<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#101010"><title>POSO | Nuestra carta</title>
<style>
:root{--ink:#171717;--paper:#f3f0e9;--gold:#c5a66b;--muted:#777;--line:#d9d3c7}*{box-sizing:border-box}body{margin:0;background:#111;color:var(--ink);font-family:Arial,Helvetica,sans-serif}header{padding:34px 18px 30px;text-align:center;color:#f6f2ea;background:radial-gradient(ellipse at top,#35312a,#101010 68%);border-bottom:1px solid #5a4930}.brand{font-family:Georgia,serif;font-size:clamp(42px,12vw,66px);letter-spacing:.18em;margin:0 0 7px .18em;font-weight:500}.tagline{color:var(--gold);letter-spacing:.23em;text-transform:uppercase;font-size:11px}main{max-width:920px;margin:0 auto;background:var(--paper);min-height:70vh;padding:24px 16px 60px}h2{font-family:Georgia,serif;font-size:29px;font-weight:500;text-align:center;margin:7px 0 22px}.search{width:100%;padding:13px 14px;border:1px solid var(--line);border-radius:3px;background:#fff;font-size:16px;margin-bottom:14px}.pills{display:flex;gap:8px;overflow:auto;padding:2px 0 16px}.pill{white-space:nowrap;border:1px solid #b9b1a3;padding:9px 13px;border-radius:99px;background:transparent;color:#292929}.pill.active{background:#171717;color:#f8f4ed;border-color:#171717}.notice{padding:12px;background:#fff8e8;border:1px solid #e6d6ad;font-size:13px;line-height:1.5;margin:12px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,245px),1fr));gap:13px}.item{background:#fff;border:1px solid #e3ded4;overflow:hidden}.item img{width:100%;height:175px;object-fit:cover;display:block;background:#e3ded4}.item .body{padding:14px}.item h3{margin:0 0 7px;font:500 20px Georgia,serif}.desc{font-size:14px;line-height:1.45;color:#65615b;margin:0 0 12px;white-space:pre-wrap}.price{font-weight:700;letter-spacing:.02em}.empty{padding:30px;text-align:center;color:#777}footer{text-align:center;color:#aaa;font-size:12px;padding:22px}.admin-link{display:inline-block;margin-top:17px;color:#c5a66b;font-size:12px;text-decoration:none}.panel{max-width:920px;margin:18px auto;background:#f3f0e9;padding:18px;border-radius:4px}.panel h2{text-align:left;font-size:25px}.field{display:flex;flex-direction:column;gap:6px;margin:10px 0}.field label{font-size:13px;color:#4e4a43}.field input,.field textarea,.field select{width:100%;padding:11px;border:1px solid #cfc7ba;border-radius:3px;font:inherit;background:#fff}.field textarea{min-height:75px;resize:vertical}.btn{padding:11px 14px;border:1px solid #1b1b1b;background:#1b1b1b;color:#fff;border-radius:3px;font:inherit;cursor:pointer}.btn.secondary{background:transparent;color:#1b1b1b}.btn.danger{background:#8b2828;border-color:#8b2828}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.admin-item{display:flex;gap:10px;align-items:center;justify-content:space-between;background:white;border:1px solid #ddd5c8;padding:11px;margin:8px 0;flex-wrap:wrap}.admin-item small{display:block;color:#777;margin-top:4px}.hidden{display:none!important}.status{font-size:13px;line-height:1.45;margin:10px 0}.status.error{color:#a21e1e}.status.ok{color:#236b38}.subhead{font-size:18px;margin:25px 0 10px;border-bottom:1px solid #d9d3c7;padding-bottom:7px}@media(min-width:650px){main{padding:30px 28px 60px}.panel{padding:24px}}
</style></head><body>
<header><p class="brand">POSO</p><div class="tagline">Restaurante · Bar</div><a class="admin-link" href="#admin" id="adminLink">Acceso administración</a></header>
<main id="publicMenu"><h2>Nuestra carta</h2><input class="search" id="search" type="search" placeholder="Buscar en la carta…" aria-label="Buscar en la carta"><nav class="pills" id="categories"><button class="pill active" data-id="all">Todos</button></nav><div id="loadStatus" class="status"></div><div id="menuGrid" class="grid"></div></main>
<section class="panel hidden" id="admin"><div id="loginBox"><h2>Administración POSO</h2><p>Ingresá con el correo y la contraseña del usuario que creaste en Supabase.</p><div class="field"><label for="email">Correo electrónico</label><input id="email" type="email" autocomplete="username" placeholder="tu@email.com"></div><div class="field"><label for="password">Contraseña</label><input id="password" type="password" autocomplete="current-password" placeholder="Contraseña"></div><div class="actions"><button class="btn" id="loginBtn">Iniciar sesión</button><button class="btn secondary" id="closeAdmin">Volver a la carta</button></div><div class="status" id="loginStatus"></div></div>
<div id="adminBox" class="hidden"><h2>Panel de administración</h2><p>Gestioná categorías, productos, precios y disponibilidad.</p><div class="actions"><button class="btn secondary" id="logoutBtn">Cerrar sesión</button><button class="btn secondary" id="refreshBtn">Actualizar carta</button></div><div id="adminStatus" class="status"></div>
<h3 class="subhead">Categorías</h3><form id="categoryForm"><input type="hidden" id="categoryId"><div class="field"><label for="categoryName">Nombre de categoría</label><input id="categoryName" required maxlength="80" placeholder="Ej.: Tragos"></div><div class="actions"><button class="btn" type="submit">Guardar categoría</button><button class="btn secondary" type="button" id="cancelCategory">Cancelar</button></div></form><div id="categoryList"></div>
<h3 class="subhead">Productos</h3><form id="productForm"><input type="hidden" id="productId"><div class="field"><label for="productName">Nombre del producto</label><input id="productName" required maxlength="120" placeholder="Ej.: Gin tonic"></div><div class="field"><label for="productCategory">Categoría</label><select id="productCategory"><option value="">Sin categoría</option></select></div><div class="field"><label for="productDescription">Descripción / ingredientes</label><textarea id="productDescription" maxlength="1200" placeholder="Descripción del producto"></textarea></div><div class="field"><label for="productPrice">Precio (ARS)</label><input id="productPrice" type="number" min="0" step="0.01" required placeholder="Ej.: 4500"></div><div class="field"><label for="productImage">URL de imagen (opcional)</label><input id="productImage" type="url" placeholder="https://…"></div><div class="field"><label><input id="productAvailable" type="checkbox" checked style="width:auto"> Disponible en la carta pública</label></div><div class="actions"><button class="btn" type="submit">Guardar producto</button><button class="btn secondary" type="button" id="cancelProduct">Cancelar</button></div></form><div id="productList"></div></div></section><footer>POSO · Carta digital</footer>
<script type="module">
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';
const SUPABASE_URL='https://niohwjztygeguiaqndtn.supabase.co';
const SUPABASE_PUBLISHABLE_KEY='sb_publishable_SNsBgYvvVsZxTWIQoA3Oyw_KKKgQhPb';
const supabase=createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY);
const $=id=>document.getElementById(id);let categories=[],products=[],selectedCategory='all';
const money=n=>new Intl.NumberFormat('es-AR',{style:'currency',currency:'ARS',maximumFractionDigits:2}).format(Number(n)||0);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function status(id,msg,type=''){const e=$(id);e.textContent=msg;e.className='status '+type}
function openAdmin(){ $('admin').classList.remove('hidden');location.hash='admin';}
function closeAdmin(){ $('admin').classList.add('hidden');history.replaceState(null,'',location.pathname+location.search)}
$('adminLink').onclick=e=>{e.preventDefault();openAdmin()};$('closeAdmin').onclick=closeAdmin;$('search').oninput=renderMenu;
$('categories').onclick=e=>{const b=e.target.closest('button[data-id]');if(!b)return;selectedCategory=b.dataset.id;renderCategories();renderMenu()};
async function loadPublic(){status('loadStatus','Cargando carta…');const [c,p]=await Promise.all([supabase.from('categories').select('id,name,position,active').eq('active',true).order('position').order('name'),supabase.from('products').select('id,category_id,name,description,price,image_url,available,position').eq('available',true).order('position').order('name')]);if(c.error||p.error){status('loadStatus','No se pudo cargar la carta: '+(c.error?.message||p.error?.message),'error');return}categories=c.data||[];products=p.data||[];renderCategories();renderMenu();status('loadStatus',products.length?'':'Todavía no hay productos cargados. Agregalos desde administración.')}
function renderCategories(){const ac=categories.filter(c=>c.active);$('categories').innerHTML='<button class="pill '+(selectedCategory==='all'?'active':'')+'" data-id="all">Todos</button>'+ac.map(c=>`<button class="pill ${String(selectedCategory)===String(c.id)?'active':''}" data-id="${c.id}">${esc(c.name)}</button>`).join('');const s=$('productCategory'),old=s.value;s.innerHTML='<option value="">Sin categoría</option>'+categories.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join('');if([...s.options].some(o=>o.value===old))s.value=old}
function renderMenu(){const q=$('search').value.trim().toLocaleLowerCase('es');const list=products.filter(p=>(selectedCategory==='all'||String(p.category_id)===String(selectedCategory))&&(`${p.name} ${p.description||''}`).toLocaleLowerCase('es').includes(q));$('menuGrid').innerHTML=list.length?list.map(p=>`<article class="item">${p.image_url?`<img loading="lazy" src="${esc(p.image_url)}" alt="${esc(p.name)}" onerror="this.style.display='none'">`:''}<div class="body"><h3>${esc(p.name)}</h3>${p.description?`<p class="desc">${esc(p.description)}</p>`:''}<div class="price">${money(p.price)}</div></div></article>`).join(''):'<div class="empty">No encontramos productos con esa búsqueda.</div>'}
async function refresh(){await loadPublic();if(!$('adminBox').classList.contains('hidden'))await loadAdminLists()}
$('loginBtn').onclick=async()=>{status('loginStatus','Ingresando…');const {error}=await supabase.auth.signInWithPassword({email:$('email').value.trim(),password:$('password').value});if(error){status('loginStatus','No se pudo iniciar sesión: '+error.message,'error');return}$('loginBox').classList.add('hidden');$('adminBox').classList.remove('hidden');status('loginStatus','');await loadAdminLists()};
$('password').onkeydown=e=>{if(e.key==='Enter')$('loginBtn').click()};
$('logoutBtn').onclick=async()=>{await supabase.auth.signOut();$('adminBox').classList.add('hidden');$('loginBox').classList.remove('hidden');status('loginStatus','Sesión cerrada.')};$('refreshBtn').onclick=refresh;
async function loadAdminLists(){status('adminStatus','Cargando administración…');const [c,p]=await Promise.all([supabase.from('categories').select('*').order('position').order('name'),supabase.from('products').select('*').order('position').order('name')]);if(c.error||p.error){status('adminStatus','Error al cargar: '+(c.error?.message||p.error?.message),'error');return}categories=c.data||[];products=p.data||[];renderCategories();renderMenu();$('categoryList').innerHTML=categories.length?categories.map(c=>`<div class="admin-item"><div><strong>${esc(c.name)}</strong><small>${c.active?'Activa':'Oculta'}</small></div><div class="actions"><button class="btn secondary" data-edit-category="${c.id}">Editar</button><button class="btn secondary" data-toggle-category="${c.id}">${c.active?'Ocultar':'Activar'}</button><button class="btn danger" data-delete-category="${c.id}">Eliminar</button></div></div>`).join(''):'<p>Aún no hay categorías.</p>';$('productList').innerHTML=products.length?products.map(p=>`<div class="admin-item"><div><strong>${esc(p.name)}</strong><small>${money(p.price)} · ${p.available?'Disponible':'Oculto'}</small></div><div class="actions"><button class="btn secondary" data-edit-product="${p.id}">Editar</button><button class="btn secondary" data-toggle-product="${p.id}">${p.available?'Ocultar':'Mostrar'}</button><button class="btn danger" data-delete-product="${p.id}">Eliminar</button></div></div>`).join(''):'<p>Aún no hay productos.</p>';status('adminStatus','Datos actualizados.','ok')}
$('categoryForm').onsubmit=async e=>{e.preventDefault();const id=$('categoryId').value,name=$('categoryName').value.trim();const data={name,position:id?(categories.find(c=>String(c.id)===id)?.position||0):categories.length,active:true};const r=id?await supabase.from('categories').update(data).eq('id',id):await supabase.from('categories').insert(data);if(r.error){status('adminStatus','No se pudo guardar: '+r.error.message,'error');return}$('categoryForm').reset();$('categoryId').value='';await loadAdminLists()};
$('cancelCategory').onclick=()=>{$('categoryForm').reset();$('categoryId').value=''};
$('categoryList').onclick=async e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.editCategory){const c=categories.find(x=>String(x.id)===b.dataset.editCategory);if(c){$('categoryId').value=c.id;$('categoryName').value=c.name;scrollTo({top:$('categoryForm').getBoundingClientRect().top+scrollY-20,behavior:'smooth'})}return}if(b.dataset.toggleCategory){const c=categories.find(x=>String(x.id)===b.dataset.toggleCategory);const r=await supabase.from('categories').update({active:!c.active}).eq('id',c.id);if(r.error)status('adminStatus',r.error.message,'error');else await loadAdminLists();return}if(b.dataset.deleteCategory){if(!confirm('¿Eliminar esta categoría? Los productos quedarán sin categoría.'))return;const r=await supabase.from('categories').delete().eq('id',b.dataset.deleteCategory);if(r.error)status('adminStatus',r.error.message,'error');else await loadAdminLists()}};
$('productForm').onsubmit=async e=>{e.preventDefault();const id=$('productId').value,price=Number($('productPrice').value);if(!Number.isFinite(price)||price<0){status('adminStatus','Ingresá un precio válido.','error');return}const data={name:$('productName').value.trim(),category_id:$('productCategory').value?Number($('productCategory').value):null,description:$('productDescription').value.trim(),price,image_url:$('productImage').value.trim()||null,available:$('productAvailable').checked,position:id?(products.find(p=>String(p.id)===id)?.position||0):products.length};const r=id?await supabase.from('products').update(data).eq('id',id):await supabase.from('products').insert(data);if(r.error){status('adminStatus','No se pudo guardar: '+r.error.message,'error');return}$('productForm').reset();$('productId').value='';$('productAvailable').checked=true;await loadAdminLists()};
$('cancelProduct').onclick=()=>{$('productForm').reset();$('productId').value='';$('productAvailable').checked=true};
$('productList').onclick=async e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.editProduct){const p=products.find(x=>String(x.id)===b.dataset.editProduct);if(!p)return;$('productId').value=p.id;$('productName').value=p.name;$('productCategory').value=p.category_id??'';$('productDescription').value=p.description||'';$('productPrice').value=p.price;$('productImage').value=p.image_url||'';$('productAvailable').checked=p.available;scrollTo({top:$('productForm').getBoundingClientRect().top+scrollY-20,behavior:'smooth'});return}if(b.dataset.toggleProduct){const p=products.find(x=>String(x.id)===b.dataset.toggleProduct);const r=await supabase.from('products').update({available:!p.available}).eq('id',p.id);if(r.error)status('adminStatus',r.error.message,'error');else await loadAdminLists();return}if(b.dataset.deleteProduct){if(!confirm('¿Eliminar este producto definitivamente?'))return;const r=await supabase.from('products').delete().eq('id',b.dataset.deleteProduct);if(r.error)status('adminStatus',r.error.message,'error');else await loadAdminLists()}};
supabase.auth.onAuthStateChange((_event,session)=>{if(session){$('loginBox').classList.add('hidden');$('adminBox').classList.remove('hidden')}else{$('adminBox').classList.add('hidden');$('loginBox').classList.remove('hidden')}});
if(location.hash==='#admin')openAdmin();loadPublic();
</script></body></html>
